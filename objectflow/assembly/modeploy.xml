<?xml version="1.0" encoding="UTF-8"?>
<!--


 modeploy.xml: Examples of deployment and undeployment 
        	   for moware in conjunction with tomcat
            
 daniel stieger, autumn 2025, koblach

 
 
 
 export JAVA_HOME=/Library/Java/JavaVirtualMachines/jbr17/Contents/Home
 export PATH=$PATH:/Users/danielstieger/javaexe/ant/bin
 
-->
 
<project name="MoWareTommyDeployment">      

  <!-- ><include file="bmoware.xml" as="bmoware"/> -->
  <property name="mowarePluginHomeDir"   value="/Users/danielstieger/javaexe/MoPluginFake17" />

  <include file="moware.xml" as="moware"/>

  <property name="deployWarFile"       value="/Users/danielstieger/migration/2024_1/moware/turkuforms/assembly/dist/simpleone.war"/>
  <property name="deployContextPath"   value="/simpleone"/>
  
  <!-- Tomcat-Manager Access -->  

  <property name="deployUrl"   			value="http://localhost:8080/manager/text"/> <!-- TEXT API /text and not html! -->
  <property name="deployUser"   		value="tomcat"/>
  <property name="deployPass"			value="tomcat"/>


 
  <!-- "war" property will deploy from local fs and upload file to server, howevver, catalina.jar is needed 
  	   "localWar" property will copy file from server fs to tomcat webapps and deploy it. 	

	   version="1.0" für parallel deployment   
  -->
  <target name="deployTommy" description="Deploy local war file to tomcat">
    <deploy url="${deployUrl}" username="${deployUser}" password="${deployPass}"
            path="${deployContextPath}" war="file:${deployWarFile}" update="true" version="18.2026"/>
  </target>

  <target name="undeployTommy" description="UnDeploy local war file from tomcat">
    <undeploy url="${deployUrl}" username="${deployUser}" password="${deployPass}"
              path="${deployContextPath}"/>
  </target>
  
  
</project>